{
  "openapi": "3.0.4",
  "info": {
    "title": "Ripple Ticketing API",
    "version": "v1"
  },
  "paths": {
    "/api/v1/events": {
      "post": {
        "tags": [
          "Events"
        ],
        "summary": "Create a new event",
        "operationId": "CreateEvent",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateEventRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "get": {
        "tags": [
          "Events"
        ],
        "summary": "List all events",
        "operationId": "GetAllEvents",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/events/{id}": {
      "delete": {
        "tags": [
          "Events"
        ],
        "summary": "Delete an event",
        "operationId": "DeleteEvent",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "get": {
        "tags": [
          "Events"
        ],
        "summary": "Get event by ID",
        "operationId": "GetEvent",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "put": {
        "tags": [
          "Events"
        ],
        "summary": "Replace an event",
        "operationId": "UpdateEvent",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateEventRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/reports/sales": {
      "get": {
        "tags": [
          "Reports"
        ],
        "summary": "Get ticket sales summary for all events",
        "operationId": "GetAllSalesReports",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/reports/sales/{eventId}": {
      "get": {
        "tags": [
          "Reports"
        ],
        "summary": "Get ticket sales summary for a specific event",
        "operationId": "GetEventSalesReport",
        "parameters": [
          {
            "name": "eventId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/events/{eventId}/availability": {
      "get": {
        "tags": [
          "Tickets"
        ],
        "summary": "Get ticket availability for an event",
        "operationId": "GetAvailability",
        "parameters": [
          {
            "name": "eventId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/events/{eventId}/tickets": {
      "post": {
        "tags": [
          "Tickets"
        ],
        "summary": "Purchase tickets for an event",
        "operationId": "PurchaseTickets",
        "parameters": [
          {
            "name": "eventId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PurchaseTicketRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreateEventRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "nullable": true
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "venue": {
            "type": "string",
            "nullable": true
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "time": {
            "type": "string",
            "format": "time"
          },
          "totalCapacity": {
            "type": "integer",
            "format": "int32"
          },
          "pricingTiers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CreatePricingTierRequest"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "CreatePricingTierRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "nullable": true
          },
          "price": {
            "type": "number",
            "format": "double"
          },
          "capacity": {
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "PurchaseTicketRequest": {
        "type": "object",
        "properties": {
          "pricingTierId": {
            "type": "string",
            "format": "uuid"
          },
          "quantity": {
            "type": "integer",
            "format": "int32"
          },
          "purchaserName": {
            "type": "string",
            "nullable": true
          },
          "purchaserEmail": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "UpdateEventRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "nullable": true
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "venue": {
            "type": "string",
            "nullable": true
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "time": {
            "type": "string",
            "format": "time"
          },
          "totalCapacity": {
            "type": "integer",
            "format": "int32"
          },
          "pricingTiers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CreatePricingTierRequest"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      }
    }
  },
  "tags": [
    {
      "name": "Events"
    },
    {
      "name": "Reports"
    },
    {
      "name": "Tickets"
    }
  ]
}